# Leave LNBITS_* empty to run in DEMO mode (mock invoices + "simulate payment" button)
LNBITS_URL=https://demo.lnbits.com
LNBITS_INVOICE_KEY=
APP_URL=http://localhost:3000
KES_PER_SAT=0.12
AT_USERNAME=sandbox
AT_API_KEY=

# Optional: enables BillBridge Help AI via OpenRouter (falls back to built-in FAQ if empty)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free


# Public URL used in WhatsApp share links (set to your Vercel URL when deployed)
NEXT_PUBLIC_APP_URL=

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/billbridge?schema=public"
